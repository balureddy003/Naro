{
  "name": "naro",
  "version": "0.1.0",
  "private": true,
  "description": "Naro \u2014 a universal, open-source foundation for building autonomous agents.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "core",
    "runtime",
    "model",
    "tools",
    "environment",
    "memory",
    "context",
    "reasoning",
    "policy",
    "observability",
    "evaluation",
    "verification",
    "multiagent",
    "adapters/*",
    "profiles/*",
    "examples/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "node --test \"*/src/**/*.test.ts\" \"adapters/*/src/**/*.test.ts\" \"examples/*/src/**/*.test.ts\"",
    "check": "npm run build && npm test",
    "clean": "tsc -b --clean",
    "example": "node examples/minimal-agent/src/index.ts",
    "example:react": "node examples/react-agent/src/index.ts",
    "example:coding": "node examples/coding-agent/src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
