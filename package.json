{
  "name": "naro",
  "version": "0.1.0",
  "private": true,
  "description": "Naro \u2014 a universal, open-source foundation for building autonomous agents.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "core",
    "runtime",
    "model",
    "tools",
    "environment",
    "memory",
    "context",
    "reasoning",
    "policy",
    "observability",
    "evaluation",
    "verification",
    "multiagent",
    "adapters/*",
    "contract-tests",
    "cli",
    "profiles/*",
    "examples/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "node --test \"*/src/**/*.test.ts\" \"adapters/*/src/**/*.test.ts\" \"profiles/*/src/**/*.test.ts\" \"examples/*/src/**/*.test.ts\"",
    "check": "npm run build && npm test && npm run pack:check",
    "clean": "tsc -b --clean",
    "example": "node examples/minimal-agent/src/index.ts",
    "example:react": "node examples/react-agent/src/index.ts",
    "example:coding": "node examples/coding-agent/src/index.ts",
    "example:governed": "node examples/governed-agent/src/index.ts",
    "example:research": "node examples/research-agent/src/index.ts",
    "pack:check": "node scripts/pack-check.mjs",
    "changeset": "changeset",
    "version-packages": "npm run build && changeset version",
    "release": "npm run check && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "2.29.8",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
